    # Balasan otomatis sederhana
    response = f"Rekomendasi KulinerBuddyAI untuk '{prompt}': Coba kunjungi **Ayam Geprek Sambal Korek** dekat sini! ⭐ 4.8"
    st.chat_message("assistant").markdown(response)
